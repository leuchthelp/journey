    "tailwindcss": "^4.3.3",
    "taurpc": "^2.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "uuid": "^14.0.1",
    "vitest": "^5.0.0-beta.6"
