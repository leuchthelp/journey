{
  "name": "journey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "dx prettier --write .",
    "tauri": "tauri",
    "generate": "dx drizzle-kit generate && deno ./src/lib/db/compile-migrations.ts"
  },
  "dependencies": {
